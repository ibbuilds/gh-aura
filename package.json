{
  "name": "gh-aura",
  "version": "1.15.0",
  "description": "Local-first CLI for GitHub contribution activity, achievements, and profile workflows.",
  "type": "module",
  "bin": {
    "gh-aura": "./src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "start": "node src/cli.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibbuilds/gh-aura.git"
  },
  "homepage": "https://github.com/ibbuilds/gh-aura#readme",
  "bugs": {
    "url": "https://github.com/ibbuilds/gh-aura/issues"
  },
  "keywords": [
    "github",
    "profile",
    "cli",
    "readme",
    "portfolio"
  ],
  "license": "MIT"
}
